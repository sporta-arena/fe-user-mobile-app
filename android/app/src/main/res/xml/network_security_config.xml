<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTP polos hanya diizinkan untuk alias host emulator dan localhost,
         supaya run lokal (DEV_MODE=android / ios) bisa menembak backend
         docker di mesin dev — termasuk WebSocket Reverb di port 8080.
         Lalu lintas staging dan produksi tetap wajib HTTPS.

         Isinya sengaja sama persis dengan milik app mitra, supaya kedua
         aplikasi punya aturan jaringan yang seragam. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- SEMENTARA: VPS produksi masih diakses lewat IP mentah karena
             domainnya belum diarahkan, jadi belum bisa punya sertifikat.
             CABUT baris ini begitu api.sportago.id hidup dengan HTTPS —
             membiarkannya berarti aplikasi rilis tetap boleh berbicara
             tanpa enkripsi ke host itu. -->
        <domain includeSubdomains="false">43.156.46.189</domain>
    </domain-config>
</network-security-config>
