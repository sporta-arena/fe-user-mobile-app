<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ memakai layar pembuka sistem, bukan launch_background.
         Latarnya disamakan dengan splash Flutter (@color/latar_pembuka)
         supaya peluncuran tidak berkedip putih lalu hijau. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/latar_pembuka</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
